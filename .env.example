# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# Google AI Studio key (free tier, no credit card): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model config — everything swappable. All default to the current Gemini Flash model.
# ENGINE_MODEL is the model that answers buyer questions (with Google Search grounding).
# PARSER_MODEL extracts structured data from answers. PROMPTGEN_MODEL generates buyer questions (M1).
ENGINE_MODEL=gemini-3.5-flash
PARSER_MODEL=gemini-3.5-flash
PROMPTGEN_MODEL=gemini-3.5-flash
INTERVENTION_MODEL=gemini-3.5-flash
BUSINESS_UNDERSTANDING_MAX_PAGES=12
BUYER_INTENT_QUESTION_COUNT=20

# Supabase — server-only. The browser talks only to this app's /api proxy.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clerk — only the publishable key is browser-safe. The secret and webhook
# signing secret must exist only in server/deployment secret storage.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_FRONTEND_API_PROXY_ENABLED=true
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/onboarding

# Email — provider is selected in lib/email/mailer.ts (default: Brevo).
# Brevo: free 300/day, sends from a verified sender address (no domain needed).
#   Brevo dashboard → SMTP & API → API Keys, and → Senders to verify EMAIL_FROM.
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=you@yourverifiedsender.com
EMAIL_FROM_NAME=BrandPulse
# Razorpay — test keys from https://dashboard.razorpay.com/app/keys
# Webhook URL (production): https://your-domain.com/api/billing/verify
# Subscribe to: payment.captured, order.paid, payment.refunded
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


MAX_TOTAL_SPEND_INR=1000
RUN_COST_CAP_CENTS=30
USD_INR=90
CALL_TIMEOUT_MS=90000
MAX_RETRIES=2
OBSERVATION_CONCURRENCY=1
DIAGNOSIS_CONCURRENCY=4
INTERVENTION_CONCURRENCY=4
OBSERVATION_MAX_RETRIES=2
PROMPT_DELAY_MS=2000
CONCURRENCY=1

# App — REQUIRED on Vercel production deploy
# Set to your real domain (no trailing slash). Used for report links in emails
# and Supabase auth redirects. Example: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk owns sign-in/sign-up redirects. Add the production domain and redirect URLs
# in Clerk, and configure Clerk under Supabase Authentication → Third-party Auth.

# Cron auth (Vercel cron sends this as a Bearer token)
CRON_SECRET=your_cron_secret

# Random server-only HMAC key used to hash network/email abuse identifiers before
# database storage. Use at least 32 random bytes and never expose it to the browser.
RATE_LIMIT_SALT=replace_with_at_least_32_random_characters

# Non-Vercel production only: name the client-IP header set and sanitized by your
# trusted reverse proxy (for example cf-connecting-ip). Never trust a header that
# the public client can supply directly. Vercel is detected automatically.
# TRUSTED_PROXY_IP_HEADER=cf-connecting-ip

# Persistent worker tuning (Render/Railway/Fly.io or another long-lived process).
WORKER_POLL_MS=5000
WORKER_STALE_MINUTES=15

# Separate founder-only bearer token for internal administrative routes.
ADMIN_SECRET=your_admin_secret

# Comma-separated, server-only allowlist for /dashboard/ops.
ADMIN_EMAILS=founder@example.com

# Public free-audit safety limits. Intake fails closed in production when
# Supabase/service-role configuration is missing.
FREE_AUDIT_DAILY_LIMIT=10

# Legacy direct pipeline endpoint. Keep false in public environments; enabling
# it still requires Authorization: Bearer <ADMIN_SECRET> and clamps to 40 prompts.
DIRECT_AUDIT_ENABLED=false

# Non-login internal profile for public free audits. Create it with the SQL in
# DEPLOYMENT.md and copy the returned UUID here. It owns unclaimed audit rows only.
GUEST_AUDIT_USER_ID=

# --- Outreach audits + AI Visibility Sprint (npm run outreach) ---
# Where "Book a walkthrough" buttons on /sprint and outreach reports point.
# Use an https booking link (e.g. Cal.com) and/or a contact email. If neither
# is set, the buttons are hidden rather than shipping a dead link.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number for the report's main "Message me" button: digits with
# country code, e.g. 919876543210. Unset → the booking link is the main button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Name shown as the person who prepared audit reports, e.g. "Your Name, founder".
NEXT_PUBLIC_FOUNDER_NAME=
# Base URL used in drafted outreach messages (your deployed domain).
OUTREACH_BASE_URL=
# Engine model for outreach audits. Defaults to gemini-2.5-flash (cheaper,
# free daily search grounding). The report always states the model used.
OUTREACH_ENGINE_MODEL=

# Admin console on its own subdomain (production). When set, /admin on the main
# site redirects here and Clerk accepts sessions from this origin. Leave unset
# locally to keep using /admin (or test via http://admin.localhost:3001).
NEXT_PUBLIC_ADMIN_URL=
