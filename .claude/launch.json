{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "launch-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "brandpulse-launch", "run", "dev", "--", "--port", "3100", "--no-open"],
      "port": 3100
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3002,
      "autoPort": true
    }
  ]
}
